{
  "version": 2,
  "buildCommand": "npm ci --prefix web-admin && npm run build --prefix web-admin",
  "outputDirectory": "web-admin/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tienda-puntos-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
