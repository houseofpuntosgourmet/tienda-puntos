NODE_ENV=development
PORT=3001
# Postgres (en producción, Neon: Vercel la carga sola al conectar la base al proyecto)
DATABASE_URL=postgresql://user:password@localhost:5432/tienda_puntos
# Clave para firmar los tokens de admin. En producción es obligatoria.
JWT_SECRET=una-clave-larga-y-aleatoria
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
REDIS_URL=redis://localhost:6379
